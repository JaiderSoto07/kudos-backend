  <diagram id="d1" name="Moderación de contenido"><mxGraphModel grid="1" gridSize="10" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b2" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="285" y="0" width="30" height="30" as="geometry"/></mxCell><mxCell id="b3" value="Un usuario reporta un Kudo o una réplica con motivo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="60" width="200" height="60" as="geometry"/></mxCell><mxCell id="b4" value="¿Contenido vetado, propio o con reporte abierto del mismo usuario?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="160" width="160" height="90" as="geometry"/></mxCell><mxCell id="b5" value="Rechazar el reporte" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="170" width="200" height="60" as="geometry"/></mxCell><mxCell id="b6" value="Registrar reporte PENDIENTE; si el contenido estaba VISIBLE pasa a REPORTADO" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="290" width="200" height="60" as="geometry"/></mxCell><mxCell id="b7" value="El moderador (Rector o Coord. Académico) inicia la revisión" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="390" width="200" height="60" as="geometry"/></mxCell><mxCell id="b8" value="Contenido y reportes pendientes pasan a EN_REVISION" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="480" width="200" height="60" as="geometry"/></mxC