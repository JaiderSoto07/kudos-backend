  <diagram id="d0" name="Registro y activación de una cuenta"><mxGraphModel grid="1" gridSize="10" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b2" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="285" y="0" width="30" height="30" as="geometry"/></mxCell><mxCell id="b3" value="Diligenciar datos, rol solicitado y programa o facultad" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="60" width="200" height="60" as="geometry"/></mxCell><mxCell id="b4" value="¿Datos válidos y correo/celular únicos?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="150" width="160" height="90" as="geometry"/></mxCell><mxCell id="b5" value="Mostrar el error y no registrar" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="160" width="200" height="60" as="geometry"/></mxCell><mxCell id="b6" value="Crear cuenta PENDIENTE_APROBACION y solicitud PENDIENTE; enviar códigos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="270" width="200" height="60" as="geometry"/></mxCell><mxCell id="b7" value="Notificar a la autoridad aprobadora" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="360" width="200" height="60" as="geometry"/></mxCell><mxCell id="b8" value="La persona verifica correo y celular con los códigos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="460" width="200" height="60" as="geometry"/></mxCell><mxCell id="b9" value="La autoridad revisa la solicitud" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="460" width="200" height="60" as="geometry"/></mxCell><mxCell id="b10" value="¿Aprueba?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="560" width="160" height="90" as="geometry"/></mxCell><mxCell id="b11" value="Rechazar con motivo y notificar" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="570" width="200" height="60" as="geometry"/></mxCell><mxCell id="b12" value="Asignar rol (sustituir coordinador si aplica) y aprobar la cuenta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="670" width="200" height="60" as="geometry"/></mxCell><mxCell id="b13" value="¿Aprobada y con correo y celular verificados?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="780" width="160" height="90" as="geometry"/></mxCell><mxCell id="b14" value="Cuenta ACTIVA: puede iniciar sesión" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="890" width="200" height="60" as="geometry"/></mxCell><mxCell id="b15" value="Cuenta PENDIENTE_VERIFICACION: al verificar el dato faltante se vuelve a evaluar (CU-017)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="790" width="200" height="60" as="geometry"/></mxCell><mxCell id="b16" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="285" y="990" widt